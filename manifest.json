{
  "manifest_version": 3,
  "name": "PromptZip",
  "version": "1.0.0",
  "description": "Automatically compress large pasted text in ChatGPT and upload it as a ZIP archive.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["jszip.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PromptZip",
    "default_popup": "popup.html"
  }
}
